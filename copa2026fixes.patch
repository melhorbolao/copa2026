 src/app/palpites/PalpitesContent.tsx   |  7 ++++-
 src/app/palpites/ThirdPlaceContext.tsx | 41 +++++++++++++++++++++-----
 src/app/palpites/ThirdPlaceSection.tsx | 36 ++++++++++++++++++----
 4 files changed, 82 insertions(+), 20 deletions(-)

